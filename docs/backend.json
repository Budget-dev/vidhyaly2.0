{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Comprehensive student profile including subscription and activity tracking.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "subscriptionPlan": { "type": "string", "enum": ["free", "pro"] },
        "subscriptionStartDate": { "type": "string", "format": "date-time" },
        "subscriptionExpiryDate": { "type": "string", "format": "date-time" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "loginProvider": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin", "super-admin"] },
        "age": { "type": "string" },
        "googleAiApiKey": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "AdminProfile": {
      "title": "Admin Profile",
      "description": "Restricted document for administrative accounts.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "createdDate": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "email"]
    },
    "AdminAuditLog": {
      "title": "Admin Audit Log",
      "description": "Immutable record of administrative actions for security tracking.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "action": { "type": "string" },
        "targetUserId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "action", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection storing student data."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Privileged admin collection."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "System-wide audit logs."
    }
  }
}